-
-    nk_zero(&ctx->input, sizeof(ctx->input));
-    nk_zero(&ctx->style, sizeof(ctx->style));
-    nk_zero(&ctx->memory, sizeof(ctx->memory));
-
-    ctx->seq = 0;
-    ctx->build = 0;
