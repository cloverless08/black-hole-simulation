-
-        if (unicode_codepoint > 0xffff)
-            return 0;
-
-        /* they lie from endCount .. endCount + segCount */
-        /* but searchRange is the nearest power of two, so... */
-        if (unicode_codepoint >= nk_ttUSHORT(data + search + rangeShift*2))
