-        else window->scrollbar_hiding_timer = 0;
-    } else window->scrollbar_hiding_timer = 0;
-
-    /* window border */
-    if (layout->flags & NK_WINDOW_BORDER)
-    {
-        struct nk_color border_color = nk_panel_get_border_color(style, layout->type);
