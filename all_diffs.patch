+              void *pUserData) {
+#ifdef _WIN32
+    DebugBreak();
+#else
+    raise(SIGTRAP);
+#endif
+
+    return false;
+}
+
+typedef struct {
+    VkImage image;
+    VkCommandBuffer cmd;
