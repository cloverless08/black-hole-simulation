+template <class T>
+bool qbMatrix2<T>::SetElement(int row, int col, T elementValue)
+{
+	int linearIndex = Sub2Ind(row, col);
+	if (linearIndex >= 0)
+	{
+		m_matrixData[linearIndex] = elementValue;
+		return true;
+	} 
+	else 
+	{
+		return false;
+	}
