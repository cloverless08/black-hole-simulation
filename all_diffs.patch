-    const struct nk_draw_command *end;
-    NK_ASSERT(buffer);
-    NK_ASSERT(canvas);
-    if (!cmd || !buffer || !canvas)
-        return 0;
-
-    end = nk__draw_list_end(canvas, buffer);
-    if (cmd <= end) return 0;
-    return (cmd-1);
