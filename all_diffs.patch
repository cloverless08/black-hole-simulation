+	
+	m_x = rhs.GetElement(0);
+	m_y = rhs.GetElement(1);
+	m_z = rhs.GetElement(2);
+	
+	return *this;
+}
+
+template <class T>
+qbVector3<T> qbVector3<T>::operator= (const std::vector<T> &rhs)
