-void _glfwUpdateBufferScaleFromOutputsWayland(_GLFWwindow* window)
-{
-    if (wl_compositor_get_version(_glfw.wl.compositor) <
-        WL_SURFACE_SET_BUFFER_SCALE_SINCE_VERSION)
