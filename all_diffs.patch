+		cumulativeSum += (lhs.GetElement(row,0) * rhs.m_x);
+		cumulativeSum += (lhs.GetElement(row,1) * rhs.m_y);
+		cumulativeSum += (lhs.GetElement(row,2) * rhs.m_z);
+
