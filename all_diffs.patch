-                nk_uint start_glyph = nk_ttULONG(data+index_map+16+mid*12+8);
-                if (format == 12)
-                    return (int)start_glyph + (int)unicode_codepoint - (int)start_char;
-                else /* format == 13 */
-                    return (int)start_glyph;
-            }
-        }
-        return 0; /* not found */
-    }
-    /* @TODO */
-    NK_ASSERT(0);
-    return 0;
-}
