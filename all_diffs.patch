+static void registryHandleGlobalRemove(void* userData,
+                                       struct wl_registry* registry,
+                                       uint32_t name)
+{
+    for (int i = 0; i < _glfw.monitorCount; ++i)
+    {
+        _GLFWmonitor* monitor = _glfw.monitors[i];
+        if (monitor->wl.name == name)
