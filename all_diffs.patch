+/* **************************************************************************************************
+ELEMENT FUNCTIONS
+/* *************************************************************************************************/
+template <class T>
+T qbMatrix2<T>::GetElement(int row, int col) const
+{
+	int linearIndex = Sub2Ind(row, col);
+	if (linearIndex >= 0)
+		return m_matrixData[linearIndex];
+	else
+		return 0.0;
+
+}
