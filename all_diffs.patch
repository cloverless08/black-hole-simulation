-#define NK_ALIGN_PTR(x, mask)\
-    (NK_UINT_TO_PTR((NK_PTR_TO_UINT((nk_byte*)(x) + (mask-1)) & ~(mask-1))))
-#define NK_ALIGN_PTR_BACK(x, mask)\
-    (NK_UINT_TO_PTR((NK_PTR_TO_UINT((nk_byte*)(x)) & ~(mask-1))))
