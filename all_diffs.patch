+	qbVector3<T> result;
+	result.m_x = m_x - rhs.m_x;
+	result.m_y = m_y - rhs.m_y;
+	result.m_z = m_z - rhs.m_z;
+	
+	return result;
+}
+
+template <class T>
+qbVector3<T> qbVector3<T>::operator* (const T &rhs) const
+{
+	qbVector3<T> result;
+	result.m_x = m_x * rhs;
+	result.m_y = m_y * rhs;
+	result.m_z = m_z * rhs;
+	
+	return result;
+}
