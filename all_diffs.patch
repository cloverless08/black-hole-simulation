-NK_API int
-nk_strtoi(const char *str, const char **endptr)
-{
-    int neg = 1;
-    const char *p = str;
-    int value = 0;
-
-    NK_ASSERT(str);
-    if (!str) return 0;
-
-    /* skip whitespace */
-    while (*p == ' ') p++;
-    if (*p == '-') {
-        neg = -1;
-        p++;
-    }
-    while (*p && *p >= '0' && *p <= '9') {
-        value = value * 10 + (int) (*p - '0');
-        p++;
-    }
-    if (endptr)
-        *endptr = p;
-    return neg*value;
-}
-NK_API double
-nk_strtod(const char *str, const char **endptr)
-{
-    double m;
-    double neg = 1.0;
-    const char *p = str;
-    double value = 0;
-    double number = 0;
-
-    NK_ASSERT(str);
-    if (!str) return 0;
-
-    /* skip whitespace */
-    while (*p == ' ') p++;
-    if (*p == '-') {
-        neg = -1.0;
-        p++;
-    }
-
-    while (*p && *p != '.' && *p != 'e') {
-        value = value * 10.0 + (double) (*p - '0');
-        p++;
-    }
-
-    if (*p == '.') {
-        p++;
-        for(m = 0.1; *p && *p != 'e'; p++ ) {
-            value = value + (double) (*p - '0') * m;
-            m *= 0.1;
-        }
-    }
-    if (*p == 'e') {
-        int i, pow, div;
-        p++;
-        if (*p == '-') {
-            div = nk_true;
-            p++;
-        } else if (*p == '+') {
-            div = nk_false;
-            p++;
-        } else div = nk_false;
-
-        for (pow = 0; *p; p++)
-            pow = pow * 10 + (int) (*p - '0');
-
-        for (m = 1.0, i = 0; i < pow; i++)
-            m *= 10.0;
-
-        if (div)
-            value /= m;
-        else value *= m;
-    }
-    number = value * neg;
-    if (endptr)
-        *endptr = p;
-    return number;
-}
