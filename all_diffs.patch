+    window->wl.width = wndconfig->width;
+    window->wl.height = wndconfig->height;
+    window->wl.fbWidth = wndconfig->width;
+    window->wl.fbHeight = wndconfig->height;
+    window->wl.appId = _glfw_strdup(wndconfig->wl.appId);
