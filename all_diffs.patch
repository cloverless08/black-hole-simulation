-    NK_ASSERT(buffer);
-    if (!buffer) return;
-    buffer->marker[type].active = nk_true;
-    if (type == NK_BUFFER_BACK)
-        buffer->marker[type].offset = buffer->size;
-    else buffer->marker[type].offset = buffer->allocated;
