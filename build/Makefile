	$(CMAKE_COMMAND) -P "/home/cdemin/Code/Active/CSC1060 Capstone Project/build/CMakeFiles/VerifyGlobs.cmake"
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
